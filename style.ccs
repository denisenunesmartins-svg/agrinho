body {
  background-color: #4169e1; /* Azul Royal (Royal Blue) */
  color: #ffffff;           /* Branco puro para dar excelente contraste */
  font-family: Arial, Helvetica, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;      /* Centraliza horizontalmente e verticalmente */
  min-height: 100vh;        /* Garante que ocupe 100% da altura da tela */
  margin: 0;
}